                "description": "Private NIC unique ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Update one or more parameter(s) of a specified private NIC."
        },
        {
          "info": {
            "name": "Delete a private NIC",
            "type": "http"
