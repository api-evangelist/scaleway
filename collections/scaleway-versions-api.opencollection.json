{
  "opencollection": "1.0.0",
  "info": {
    "name": "Managed Database for PostgreSQL and MySQL Access Control List Versions API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Versions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all available Versions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.scaleway.com/k8s/v1/regions/:region/versions",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "The region you want to target"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "List all available versions for the creation of a new Kubernetes cluster."
        },
        {
          "info": {
            "name": "Get a Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.scaleway.com/k8s/v1/regions/:region/versions/:version_name",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "The region you want to target"
              },
              {
                "name": "version_name",
                "value": "",
                "type": "path",
                "description": "Requested version name."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Retrieve a specific Kubernetes version and its details."
        }
      ]
    }
  ],
  "bundled": true
}