{
  "opencollection": "1.0.0",
  "info": {
    "name": "Managed Database for PostgreSQL and MySQL Access Control List Privileges API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Privileges",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List user privileges for a database",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.scaleway.com/rdb/v1/regions/:region/instances/:instance_id/privileges",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "The region you want to target"
              },
              {
                "name": "instance_id",
                "value": "",
                "type": "path",
                "description": "UUID of the Database Instance."
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Criteria to use when ordering privileges listing."
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "database_name",
                "value": "",
                "type": "query",
                "description": "Name of the database."
              },
              {
                "name": "user_name",
                "value": "",
                "type": "query",
                "description": "Name of the user."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "List privileges of a user on a database. By default, the details returned in the list are ordered by creation date in ascending order, though this can be modified via the order_by field. You can define additional parameters for your query, such as `database_name` and `user_name`."
        },
        {
          "info": {
            "name": "Set user privileges for a database",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.scaleway.com/rdb/v1/regions/:region/instances/:instance_id/privileges",
            "params": [
              {
                "name": "region",
                "value": "",
                "type": "path",
                "description": "The region you want to target"
              },
              {
                "name": "instance_id",
                "value": "",
                "type": "path",
                "description": "UUID of the Database Instance."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Set the privileges of a user on a database. You must define `database_name`, `user_name` and `permission` in the request body."
        }
      ]
    }
  ],
  "bundled": true
}