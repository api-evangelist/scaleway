{
  "opencollection": "1.0.0",
  "info": {
    "name": "Managed Database for PostgreSQL and MySQL Access Control List Permission sets API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Permission sets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List permission sets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.scaleway.com/iam/v1alpha1/permission-sets",
            "params": [
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Criteria for sorting results."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of results per page. Value must be between 1 and 100."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number. Value must be greater than 1."
              },
              {
                "name": "organization_id",
                "value": "",
                "type": "query",
                "description": "Filter by Organization ID."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "List permission sets available for given Organization. You must define the `organization_id` in the query path of your request."
        }
      ]
    }
  ],
  "bundled": true
}