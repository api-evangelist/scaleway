{
  "opencollection": "1.0.0",
  "info": {
    "name": "Managed Database for PostgreSQL and MySQL Access Control List Stats API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Stats",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get usage statistics of a given Load Balancer",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.scaleway.com/lb/v1/zones/:zone/lbs/:lb_id/stats",
            "params": [
              {
                "name": "zone",
                "value": "",
                "type": "path",
                "description": "The zone you want to target"
              },
              {
                "name": "lb_id",
                "value": "",
                "type": "path",
                "description": "Load Balancer ID."
              },
              {
                "name": "backend_id",
                "value": "",
                "type": "query",
                "description": "ID of the backend."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Get usage statistics of a given Load Balancer"
        }
      ]
    }
  ],
  "bundled": true
}