          "http": {
            "method": "POST",
            "url": "https://api.scaleway.com/iam/v1alpha1/users/:user_id/initiate-connection",
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path",
                "description": "ID of the user that will be added to your connection."
