            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Set all parameters of the specified placement group."
        },
        {
          "info": {
            "name": "Update a placement group",
            "type": "http"
