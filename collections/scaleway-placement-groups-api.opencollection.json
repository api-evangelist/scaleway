              },
              {
                "name": "placement_group_id",
                "value": "",
                "type": "path",
                "description": "UUID of the placement group you want to get."
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-Auth-Token",
              "value": "{{X-Auth-Token}}",
              "placement": "header"
            }
          },
          "docs": "Get the specified placement group."
        },
        {
          "info": {
            "name": "Set placement group",
